-- 1) Сброс флага, если прошлый запуск упал
shared.Hastelepasta = nil
getgenv().Abysall = nil

-- 2) Хук 1: не даём хабу уничтожать модель Screech
--    (вместо Destroy — прячем и отключаем касание)
if getrawmetatable and newcclosure and getnamecallmethod then
    local mt = getrawmetatable(game)
    local oldNC = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "Destroy" and type(self) == "Instance"
            and self.Name == "Screech"
        then
            local p = self.Parent
            if p and p.Name == "Camera" then
                for _, d in ipairs(self:GetDescendants()) do
                    if d:IsA("BasePart") then
                        d.Transparency = 1
                        d.CanTouch = false
                        d.CanCollide = false
                        d.CanQuery = false
                    end
                end
                return nil -- съедаем Destroy, модель остаётся живой для модуля игры
            end
        end
        return oldNC(self, ...)
    end)
    setreadonly(mt, true)
    print("[Fix] Destroy-hook установлен")
else
    warn("[Fix] Нет getrawmetatable — Destroy-hook пропущен")
end

-- 3) Хук 2: не даём хабу отправлять Screech-ремоут в nil
--    (кидаем в gethui/CoreGui — модуль найдёт его, ошибки не будет)
if getrawmetatable and newcclosure then
    local mt = getrawmetatable(game)
    local oldNI = mt.__newindex
    setreadonly(mt, false)
    mt.__newindex = newcclosure(function(self, key, value)
        if key == "Parent" and value == nil
            and typeof(self) == "Instance"
            and self:IsA("RemoteEvent")
            and self.Name == "Screech"
        then
            local hidden = (gethui and gethui()) or game:GetService("CoreGui")
            return oldNI(self, key, hidden)
        end
        return oldNI(self, key, value)
    end)
    setreadonly(mt, true)
    print("[Fix] Parent-hook установлен")
else
    warn("[Fix] Нет getrawmetatable — Parent-hook пропущен")
end

