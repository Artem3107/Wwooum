--[[
    Abysall Doors — Screech Bug Fix Patcher
    Запускает Abysall с хуками, предотвращающими ошибку
    "Screech:98: attempt to index nil with 'CFrame'"
    
    Причина ошибки: чит уничтожает модель Screech,
    а модуль игры продолжает каждый кадр обращаться
    к её частям → nil.CFrame → спам ошибок → лаги.
    
    Фикс: не даём уничтожать модель, только прячем её;
    а RemoteEvent Screech не отправляем в nil.
]]

-- 1) Сброс флагов от предыдущих (упавших) запусков
shared.Hastelepasta = nil
getgenv().Abysall = nil

-- 2) URL полного скрипта
local MAIN_URL = "https://raw.githubusercontent.com/therealcookiemonsterof1966/AbysallContinued/main/Games/Doors/Main.luau"

-- 3) Проверка доступности хуков
local canHook = getrawmetatable and setreadonly and newcclosure and getnamecallmethod

if canHook then
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    local oldNewIndex = mt.__newindex

    setreadonly(mt, false)

    -- Хук 1: Screech:Destroy() -> скрыть, не уничтожать
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "Destroy" then
            local okName, name = pcall(function() return self.Name end)
            local okPar, parent = pcall(function() return self.Parent end)
            if okName and okPar and name == "Screech" and parent and parent.Name == "Camera" then
                pcall(function()
                    for _, desc in ipairs(self:GetDescendants()) do
                        if desc:IsA("BasePart") then
                            desc.CanTouch = false
                            desc.CanCollide = false
                            desc.CanQuery = false
                            desc.Transparency = 1
                        elseif desc:IsA("Decal") or desc:IsA("Texture") then
                            desc.Transparency = 1
                        elseif desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") then
                            desc.Enabled = false
                        elseif desc:IsA("PointLight") or desc:IsA("SpotLight") or desc:IsA("SurfaceLight") then
                            desc.Enabled = false
                        elseif desc:IsA("Sound") then
                            desc.Volume = 0
                        end
                    end
                end)
                -- Съедаем Destroy — модель остаётся живой для модуля игры
                return nil
            end
        end
        return oldNamecall(self, ...)
    end)

    -- Хук 2: Screech_Real.Parent = nil -> скрытая папка вместо nil
    mt.__newindex = newcclosure(function(self, key, value)
        if key == "Parent" and value == nil then
            local okName, name = pcall(function() return self.Name end)
            local okRem, isRemote = pcall(function() return self:IsA("RemoteEvent") end)
            if okName and okRem and name == "Screech" and isRemote then
                local hidden = (gethui and gethui()) or game:GetService("CoreGui")
                return oldNewIndex(self, key, hidden)
            end
        end
        return oldNewIndex(self, key, value)
    end)

    setreadonly(mt, true)
    print("[Abysall Fix] Хуки установлены (Destroy + Parent)")
else
    warn("[Abysall Fix] getrawmetatable недоступен — запуск без фикса Screech")
end

-- 4) Загрузка полного скрипта
print("[Abysall Fix] Загрузка хаба...")
local ok, err = pcall(function()
    local src = game:HttpGet(MAIN_URL)
    if not src or #src < 100000 then
        error("Не удалось скачать полный скрипт (404 или обрезан). Длина: " .. tostring(src and #src or "nil"))
    end
    loadstring(src)()
end)

if not ok then
    warn("[Abysall Fix] Ошибка: " .. tostring(err))
end
